# ── Server ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── Supabase ─────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Razorpay ─────────────────────────────────────────────────────────
# Found in: Razorpay Dashboard → Settings → API Keys

# [TEST MODE] Use these for development
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=your_test_secret_here
RAZORPAY_TEST_WEBHOOK_SECRET=your_test_webhook_secret_here

# [LIVE MODE] Use these for production ONLY
RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_LIVE_KEY_SECRET=your_live_secret_here
RAZORPAY_LIVE_WEBHOOK_SECRET=your_live_webhook_secret_here

# Toggle to 'live' when deploying to production
RAZORPAY_MODE=test

# ── Google OAuth ─────────────────────────────────────────────────────
# Found in: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── CORS ─────────────────────────────────────────────────────────────
# Your frontend URL (Vercel URL in production)
CLIENT_URL=http://localhost:5173
